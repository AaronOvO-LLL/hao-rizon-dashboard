# 复制为 deploy.env 后填真实值。deploy.env 已被 .gitignore 忽略，不会进 git。

# 服务器公网 IP（hao-rizon.com 当前解析到 129.204.31.88）
SITE_HOST=129.204.31.88

# SSH 用户（Ubuntu 镜像默认 ubuntu；用 root 登录就填 root）
SITE_USER=ubuntu

# 服务器上的仓库目录（脚本会自动 git clone 到这里，不要手建）
SITE_PATH=/srv/haorizon

# 站点域名：探活用，也用来提示证书是否就绪
SITE_DOMAIN=www.hao-rizon.com
