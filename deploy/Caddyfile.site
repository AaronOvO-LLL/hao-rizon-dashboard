# 备选方案：如果服务器上的 80/443 已经被 Caddy（例如 obsidian-sync-hub 的容器）占用，
# 就不要再装 nginx —— 一个端口只能有一个进程监听。把这个站点块追加到现有 Caddyfile 末尾。
#
# 注意：如果 Caddy 跑在 Docker 里，root 指的是“容器内路径”，
# 必须在 docker-compose.yml 里把这个目录挂进去，否则 Caddy 看不到文件：
#   volumes:
#     - /srv/haorizon/public:/srv/haorizon/public:ro
#
# 域名和邮箱沿用 Caddy 全局块里已有的配置即可。

hao-rizon.example {
	root * /srv/haorizon/public
	encode gzip zstd

	try_files {path} {path}/ =404
	file_server

	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin

	# 页面不缓存，资源长缓存
	@page path / /
	header @page Cache-Control "no-cache"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
